<processor_spec>
  <programcounter register="PC"/>
  <!-- I/O registers whose value changes without CPU writes -->
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="ram" first="0xff00" last="0xff02"/> <!-- P1 SB SC -->
    <range space="ram" first="0xff04" last="0xff05"/> <!-- DIV TIMA -->
    <range space="ram" first="0xff0f" last="0xff0f"/> <!-- IF -->
    <range space="ram" first="0xff26" last="0xff26"/> <!-- NR52 -->
    <range space="ram" first="0xff41" last="0xff41"/> <!-- STAT -->
    <range space="ram" first="0xff44" last="0xff44"/> <!-- LY -->
    <range space="ram" first="0xff4d" last="0xff4d"/> <!-- KEY1 -->
    <range space="ram" first="0xff55" last="0xff56"/> <!-- HDMA5 RP -->
    <range space="ram" first="0xff68" last="0xff6b"/> <!-- BCPS BCPD OCPS OCPD -->
    <range space="ram" first="0xff76" last="0xff77"/> <!-- PCM12 PCM34 -->
  </volatile>
</processor_spec>
